Options -Indexes

RewriteEngine On

# Redirect the old project-root URL to public.
RewriteRule ^$ public/ [R=302,L]

# Allow access only through the public directory.
RewriteRule ^public(?:/|$) - [L]

# Block everything else in the project root.
RewriteRule ^ - [F,L]

# Block hidden files such as .htaccess.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>