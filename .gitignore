# Local environment file containing secrets
.env

# Files uploaded while the application is running
/public/uploads/
/vendor/
app/config/database.local.php
app/config/translation.local.php
/app/config/*.local.php
/app/links.md
/app/storage/*.local.dpapi

# Local database backups (keep only the placeholder in version control)
/app/storage/backups/*
!/app/storage/backups/.gitkeep

# Application incident logs (private; written by App\Http\ErrorBoundary)
/app/storage/logs/*
!/app/storage/logs/.gitkeep

# Short-lived public signing-key cache; regenerated from Google when needed.
/app/storage/cache/

# Uploaded D17 payment evidence (kept outside the public web root; never committed)
/app/storage/uploads/payments/*
!/app/storage/uploads/payments/.gitkeep

# Uploaded product/color photos (public, but generated at runtime; never committed)
/public/assets/products/*
!/public/assets/products/.gitkeep

# Editor and local runtime artifacts
debug.log
*.session.sql
tempCodeRunnerFile.*

# Editor and local runtime artifacts
/.vscode/settings.json
